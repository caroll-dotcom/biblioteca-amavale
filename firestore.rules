rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function role() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() == 'admin' || role() == 'volunteer';
    }

    function memberCheckoutCopy() {
      return signedIn()
        && (
          resource.data.status == 'available'
          || (
            resource.data.status == 'reserved'
            && resource.data.reservedFor == request.auth.uid
            && resource.data.reservationExpiresAt is timestamp
            && resource.data.reservationExpiresAt >= request.time
          )
        )
        && request.resource.data.status == 'borrowed'
        && request.resource.data.borrowedBy == request.auth.uid
        && request.resource.data.activeLoanId is string
        && request.resource.data.dueAt is timestamp
        && request.resource.data.reservedFor == null
        && request.resource.data.reservedWaitlistId == null
        && request.resource.data.reservationExpiresAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'borrowedBy', 'activeLoanId', 'dueAt', 'lastLoanAt',
          'reservedFor', 'reservedWaitlistId', 'reservationExpiresAt'
        ])
        && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.activeLoanId)).data.memberId == request.auth.uid
        && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.activeLoanId)).data.copyCode == resource.data.code
        && getAfter(/databases/$(database)/documents/loans/$(request.resource.data.activeLoanId)).data.status == 'borrowed';
    }

    function memberReturnCopy() {
      return signedIn()
        && resource.data.status == 'borrowed'
        && resource.data.borrowedBy == request.auth.uid
        && resource.data.activeLoanId is string
        && request.resource.data.status in ['available', 'reserved']
        && request.resource.data.borrowedBy == null
        && request.resource.data.activeLoanId == null
        && request.resource.data.dueAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'borrowedBy', 'activeLoanId', 'dueAt', 'lastReturnAt',
          'reservedFor', 'reservedWaitlistId', 'reservationExpiresAt'
        ])
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.memberId == request.auth.uid
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.copyCode == resource.data.code
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.status == 'returned'
        && (
          (
            request.resource.data.status == 'available'
            && request.resource.data.reservedFor == null
            && request.resource.data.reservedWaitlistId == null
            && request.resource.data.reservationExpiresAt == null
          )
          || (
            request.resource.data.status == 'reserved'
            && request.resource.data.reservedFor is string
            && request.resource.data.reservedWaitlistId is string
            && request.resource.data.reservationExpiresAt is timestamp
            && request.resource.data.reservationExpiresAt > request.time
            && request.resource.data.reservationExpiresAt <= request.time + duration.value(4, 'd')
            && getAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.reservedWaitlistId)).data.status == 'ready'
            && getAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.reservedWaitlistId)).data.memberId == request.resource.data.reservedFor
            && getAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.reservedWaitlistId)).data.copyCode == resource.data.code
          )
        );
    }

    function memberAdvanceReservation() {
      return signedIn()
        && resource.data.status == 'reserved'
        && resource.data.reservationExpiresAt is timestamp
        && resource.data.reservationExpiresAt <= request.time
        && request.resource.data.status in ['available', 'reserved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reservedFor', 'reservedWaitlistId', 'reservationExpiresAt'
        ])
        && (
          (
            request.resource.data.status == 'available'
            && request.resource.data.reservedFor == null
            && request.resource.data.reservedWaitlistId == null
            && request.resource.data.reservationExpiresAt == null
          )
          || (
            request.resource.data.status == 'reserved'
            && request.resource.data.reservedFor is string
            && request.resource.data.reservedWaitlistId is string
            && request.resource.data.reservationExpiresAt is timestamp
            && request.resource.data.reservationExpiresAt > request.time
            && request.resource.data.reservationExpiresAt <= request.time + duration.value(4, 'd')
            && getAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.reservedWaitlistId)).data.status == 'ready'
            && getAfter(/databases/$(database)/documents/waitlist/$(request.resource.data.reservedWaitlistId)).data.memberId == request.resource.data.reservedFor
          )
        );
    }

    function memberRenewCopy() {
      return signedIn()
        && resource.data.status == 'borrowed'
        && resource.data.borrowedBy == request.auth.uid
        && resource.data.activeLoanId is string
        && request.resource.data.status == resource.data.status
        && request.resource.data.borrowedBy == resource.data.borrowedBy
        && request.resource.data.activeLoanId == resource.data.activeLoanId
        && request.resource.data.dueAt is timestamp
        && request.resource.data.dueAt > resource.data.dueAt
        && request.resource.data.dueAt <= resource.data.dueAt + duration.value(31, 'd')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueAt'])
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.memberId == request.auth.uid
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.dueAt == request.resource.data.dueAt
        && getAfter(/databases/$(database)/documents/loans/$(resource.data.activeLoanId)).data.renewalCount == 1;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member';

      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));

      allow delete: if isAdmin();
    }

    match /books/{isbn} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /copies/{copyCode} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || memberCheckoutCopy()
        || memberReturnCopy()
        || memberAdvanceReservation()
        || memberRenewCopy();
    }

    match /waitlist/{entryId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.queueKey is string
        && request.resource.data.status == 'waiting'
        && request.resource.data.joinedAt == request.time;

      allow update: if isStaff()
        || (
          signedIn()
          && resource.data.memberId == request.auth.uid
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        )
        || (
          signedIn()
          && resource.data.memberId == request.auth.uid
          && resource.data.status == 'ready'
          && request.resource.data.status == 'fulfilled'
          && request.resource.data.fulfilledAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fulfilledAt'])
        )
        || (
          signedIn()
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'ready'
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.queueKey == resource.data.queueKey
          && request.resource.data.readyAt == request.time
          && request.resource.data.copyCode is string
          && request.resource.data.reservationExpiresAt is timestamp
          && request.resource.data.reservationExpiresAt > request.time
          && request.resource.data.reservationExpiresAt <= request.time + duration.value(4, 'd')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'readyAt', 'copyCode', 'reservationExpiresAt'
          ])
          && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.status == 'reserved'
          && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.reservedFor == resource.data.memberId
          && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.reservedWaitlistId == entryId
        )
        || (
          signedIn()
          && resource.data.status == 'ready'
          && resource.data.reservationExpiresAt is timestamp
          && resource.data.reservationExpiresAt <= request.time
          && request.resource.data.status == 'expired'
          && request.resource.data.expiredAt == request.time
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.queueKey == resource.data.queueKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiredAt'])
        )
        || (
          signedIn()
          && resource.data.memberId == request.auth.uid
          && resource.data.status in ['cancelled', 'expired', 'fulfilled']
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.queueKey == resource.data.queueKey
          && request.resource.data.status == 'waiting'
          && request.resource.data.joinedAt == request.time
          && request.resource.data.keys().hasOnly([
            'memberId', 'queueKey', 'status', 'joinedAt',
            'readyAt', 'reservationExpiresAt', 'copyCode'
          ])
        );

      allow delete: if isStaff();
    }

    match /loans/{loanId} {
      allow read: if signedIn()
        && (resource.data.memberId == request.auth.uid || isStaff());

      allow create: if signedIn()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.copyCode is string
        && request.resource.data.isbn is string
        && request.resource.data.queueKey is string
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.shelf is string
        && request.resource.data.status == 'borrowed'
        && request.resource.data.borrowedAt == request.time
        && request.resource.data.dueAt is timestamp
        && request.resource.data.dueAt > request.time
        && request.resource.data.dueAt <= request.time + duration.value(31, 'd')
        && request.resource.data.renewalCount == 0
        && request.resource.data.renewedAt == null
        && request.resource.data.returnedAt == null
        && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.status == 'borrowed'
        && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.borrowedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.activeLoanId == loanId
        && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.title == request.resource.data.title
        && getAfter(/databases/$(database)/documents/copies/$(request.resource.data.copyCode)).data.author == request.resource.data.author;

      allow update: if signedIn()
        && resource.data.memberId == request.auth.uid
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.copyCode == resource.data.copyCode
        && (
          (
            resource.data.status == 'borrowed'
            && request.resource.data.status == 'returned'
            && request.resource.data.returnedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnedAt'])
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.status in ['available', 'reserved']
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.borrowedBy == null
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.activeLoanId == null
          )
          || (
            resource.data.status == 'borrowed'
            && request.resource.data.status == 'borrowed'
            && resource.data.get('renewalCount', 0) == 0
            && request.resource.data.renewalCount == 1
            && request.resource.data.renewedAt == request.time
            && request.resource.data.dueAt is timestamp
            && request.resource.data.dueAt > resource.data.dueAt
            && request.resource.data.dueAt <= resource.data.dueAt + duration.value(31, 'd')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'dueAt', 'renewalCount', 'renewedAt'
            ])
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.status == 'borrowed'
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.borrowedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.activeLoanId == loanId
            && getAfter(/databases/$(database)/documents/copies/$(resource.data.copyCode)).data.dueAt == request.resource.data.dueAt
          )
        );

      allow delete: if isStaff();
    }
  }
}
